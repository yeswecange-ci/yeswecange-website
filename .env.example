APP_NAME=YesWeCange
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ywc-website
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- E-mails (formulaire contact/devis) ---
# "log" en local ; renseigner un vrai SMTP en production (sinon aucun lead n'est envoyé).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yeswecange.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_TO=

# --- Compte admin du back-office (utilisé par AdminUserSeeder) ---
# Laisser ADMIN_PASSWORD vide en dev génère un mot de passe aléatoire affiché une fois.
ADMIN_EMAIL=admin@yeswecange.com
ADMIN_PASSWORD=
