# =====================================================================
# Variables d'environnement à renseigner dans Coolify
# (Onglet "Environment Variables" de la ressource applicative)
# NE PAS committer de vraies valeurs secrètes dans le repo.
# =====================================================================

APP_NAME=YesWeCange
APP_ENV=production
# Générer une clé : `php artisan key:generate --show` puis coller ici
APP_KEY=
APP_DEBUG=false
APP_URL=https://yeswecange.ywcdigital.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Base de données MySQL (ressource MySQL créée dans Coolify) ---
# DB_HOST = nom interne du service MySQL fourni par Coolify
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=ywc_website
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- E-mails (formulaire de contact) ---
# IMPORTANT : en production, laisser "log" fait DISPARAÎTRE les leads (aucun
# e-mail envoyé, tout part dans les logs). Renseigner un vrai SMTP ci-dessous.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@yeswecange.com
MAIL_FROM_NAME="${APP_NAME}"
# Adresse qui reçoit les notifications de leads (défaut : MAIL_FROM_ADDRESS)
MAIL_CONTACT_TO=

# --- serversideup/php : automatisations au démarrage du conteneur ---
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_STORAGE_LINK=true
AUTORUN_LARAVEL_MIGRATION=true
AUTORUN_LARAVEL_CONFIG_CACHE=true
AUTORUN_LARAVEL_ROUTE_CACHE=true
AUTORUN_LARAVEL_VIEW_CACHE=true

# Port exposé par l'image serversideup (à indiquer dans Coolify)
PHP_OPCACHE_ENABLE=1
